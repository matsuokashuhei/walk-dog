{
  "description": "Enforce the documentation directory structure.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/validate_docs_directories.py\"",
            "timeout": 5,
            "statusMessage": "Checking docs directory structure"
          }
        ]
      }
    ]
  }
}
