# Copy to apps/.env.vps on the VPS. Own as root and restrict read access.
# Pin the release image for Compose interpolation in apps/.env (not this file):
#   RELEASE_IMAGE=<ecr-repo>@sha256:<digest>
#
# Do not set SQS_ENDPOINT or DYNAMODB_ENDPOINT on the VPS.
# Cognito, SQS, and DynamoDB use the AWS regional endpoints.

POSTGRES_DB=walkdog
POSTGRES_USER=walkdog
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_POOL_MAX=10

ENVIRONMENT=production
RELEASE=replace-with-commit-sha
SENTRY_DSN=

AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

COGNITO_USER_POOL_ID=ap-northeast-1_ReplaceMe
COGNITO_CLIENT_ID=replace-me

SQS_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/123456789012/track-points
DYNAMODB_TABLE=TrackPoints

WORKER_HEALTH_URL=http://worker:3001/health
WORKER_HEALTH_PORT=3001
