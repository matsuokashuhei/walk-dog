{
  "openapi": "3.1.0",
  "info": {
    "title": "walk / dog API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "responses": {
          "200": { "description": "Healthy" },
          "503": { "description": "Dependency unavailable" }
        }
      }
    },
    "/v1/auth/sign-up": {
      "post": {
        "tags": ["auth"],
        "responses": {
          "200": { "description": "Sign-up initiated" },
          "400": { "description": "Invalid input" },
          "409": { "description": "Already confirmed" },
          "429": { "description": "Rate limited" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/v1/auth/sign-up/verify": {
      "post": {
        "tags": ["auth"],
        "responses": {
          "200": { "description": "Verification successful" },
          "400": { "description": "Invalid code or input" },
          "409": { "description": "Already confirmed" },
          "429": { "description": "Rate limited" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/v1/auth/sign-in": {
      "post": {
        "tags": ["auth"],
        "responses": {
          "200": { "description": "Sign-in challenge started" },
          "400": { "description": "Invalid input" },
          "409": { "description": "Authentication failed" },
          "429": { "description": "Rate limited" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/v1/auth/sign-in/verify": {
      "post": {
        "tags": ["auth"],
        "responses": {
          "200": { "description": "Verification successful" },
          "400": { "description": "Invalid code or input" },
          "409": { "description": "Authentication failed" },
          "429": { "description": "Rate limited" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "tags": ["auth"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "204": { "description": "Signed out" },
          "401": { "description": "Unauthenticated" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/v1/owner": {
      "get": {
        "tags": ["owners"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Current Owner" },
          "401": { "description": "Unauthenticated" },
          "500": { "description": "Internal server error" }
        }
      },
      "patch": {
        "tags": ["owners"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Updated Owner" },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthenticated" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
