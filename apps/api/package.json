{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "test:integration": "tsx --test test/integration/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/structured-logger": "^0.1.0",
    "@hono/zod-openapi": "^1.5.1",
    "@sentry/hono": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
