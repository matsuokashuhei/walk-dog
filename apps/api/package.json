{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/server.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrument.js dist/server.js",
    "lint": "eslint .",
    "jscpd": "jscpd src --format typescript --ignore \"**/*.d.ts\"",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run jscpd && npm run knip && npm run typecheck",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "test:integration": "node --import tsx --test \"test/**/*.integration.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1101.0",
    "@hono/node-server": "^2.0.12",
    "@hono/structured-logger": "^0.1.0",
    "@hono/zod-openapi": "^1.5.1",
    "@sentry/hono": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "aws-jwt-verify": "^5.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
